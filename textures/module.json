      "name": "Ingo Wiarda",
      "email": "ingo@dewarim.de"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "relationships": {
    "recommends": [
      {
        "id": "dewarim-map-painter",
        "type": "module",
        "reason": "Shows the images as a palette folder"
      }
    ]
  },
  "flags": {
